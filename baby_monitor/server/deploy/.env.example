DOMAIN=renesas.zyxserver.online
ADMIN_USER=admin
ADMIN_PASSWORD=replace_with_long_random_password
# Generate with: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext "your-password"
ADMIN_PASSWORD_HASH=$2a$14$replace_with_caddy_hash
# Comma separated device:key pairs. Use long random keys.
BABY_MONITOR_DEVICE_KEYS=esp32cam-01:replace_with_random_device_key
BABY_MONITOR_OFFLINE_SECONDS=10
# Keep 8 until the C6 media coprocessor passes concurrent load testing; allowed 8-12.
BABY_MONITOR_VIDEO_TARGET_FPS=8
# AI is opt-in. Keep the real key only in the deployed .env file and never commit it.
BABY_MONITOR_AI_ENABLED=0
DASHSCOPE_API_KEY=
BABY_MONITOR_QWEN_MODEL=qwen-plus
# Optional workspace-specific endpoint overrides. The legacy defaults remain supported.
BABY_MONITOR_QWEN_CHAT_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
BABY_MONITOR_QWEN_TTS_MODEL=qwen-audio-3.0-tts-flash
BABY_MONITOR_QWEN_TTS_VOICE=longanhuan_v3.6
BABY_MONITOR_QWEN_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
BABY_MONITOR_AI_ASSESSMENT_INTERVAL_SECONDS=600
BABY_MONITOR_AI_EVENT_COOLDOWN_SECONDS=60
BABY_MONITOR_AI_STORY_MAX_BYTES=4194304
LOCAL_PORT=8088
# Bind before tailscale0 exists so Docker can recover automatically after reboot.
# Keep the router firewall closed; the cloud proxy still connects over Tailscale.
BABY_MONITOR_BIND_IP=0.0.0.0
PYTHON_IMAGE=docker.1ms.run/library/python:3.12-slim
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
